{
  "copy": [
    { "src": "runtime/prefs.js", "dest": "runtime" },
    { "src": "runtime/prefs.json", "dest": "runtime" },
    { "src": "runtime/support.css", "dest": "runtime" },
    { "src": "runtime/viewer.css", "dest": "runtime" },

    { "src": "generated/runtime/runtime.js", "dest": "runtime", "rename": "runtime.js" },
    { "src": "generated/runtime/worker.js", "dest": "runtime", "rename": "worker.js" },

    { "src": "images/**/*", "dest": "images" },
    { "src": "font/**/*", "dest": "font" },
    { "src": "font/**/*", "dest": "runtime/font" },

    { "src": "node_modules/@onekiloparsec/fixi-js/dist/fixi.js", "dest": "runtime" },
    { "src": "node_modules/@onekiloparsec/fixi-js/dist/fixi_core.wasm", "dest": "runtime" }
  ]
}
