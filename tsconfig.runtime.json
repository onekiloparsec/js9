{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "none",
    "outDir": "generated/runtime",
    "rootDir": "src",
    "noEmitOnError": true,
    "removeComments": false
  },
  "include": [
    "src/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/lib/**/*.ts"
  ]
}
