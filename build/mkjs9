#!/bin/bash
#set -x

JS9_SRCDIR=$(pwd)
if [ x"$1" != x ]; then
  case "$1" in
  -q*)
  DOQUICK=1
  ./mkhelper nodejs
  ;;

  *)
  JS9_INSTALLDIR="$1"
  ;;
  esac
fi

# js9: message script
# input is from same directory as this script
# output is in current directory
BFILE="${BASH_SOURCE[0]}"
BDIR="$( dirname "${BFILE}" )"
IMSGSCR="${BDIR}/js9.in"
OMSGSCR="js9"

echo "Generating $OMSGSCR script for JS9 messaging and browser use ..."
X="s#^ *JS9_SRCDIR=\".*\"#export JS9_SRCDIR=\"$JS9_SRCDIR\"#"
X="$X;s#^ *JS9_INSTALLDIR=\".*\"#export JS9_INSTALLDIR=\"$JS9_INSTALLDIR\"#"
sed "$X" < $IMSGSCR > $OMSGSCR
chmod +x $OMSGSCR

if [ x"$DOQUICK" = x1 ]; then
    # make tmp directory, in case js9 is run from here
    if [ ! -r tmp ]; then
        mkdir -p tmp
    fi
fi

exit 0
