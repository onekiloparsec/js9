{
  "name": "@onekiloparsec/js9",
  "version": "4.6.0",
  "description": "astronomical image display everywhere",
  "main": "dist/library/js9.umd.js",
  "module": "dist/library/js9.es.js",
  "types": "dist/library/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/js9.es.js",
      "require": "./dist/library/js9.umd.js"
    }
  },
  "files": [
    "dist/library",
    "README.md",
    "LICENSE",
    "MIGRATION.md"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build:runtime:ts": "tsc -p tsconfig.runtime.json",
    "build:runtime:bundle": "vite build --config vite.runtime.config.mjs",
    "ts:migration:check": "tsc -p tsconfig.migration.json",
    "ts:migration:build": "tsc -p tsconfig.pilots.build.json",
    "predev": "npm run build:runtime:ts && npm run build:runtime:bundle",
    "predev:demo": "npm run build:runtime:ts && npm run build:runtime:bundle",
    "predev:demo:plugins": "npm run build:runtime:ts && npm run build:runtime:bundle",
    "dev": "npm run dev:demo",
    "dev:demo": "vite --config demo-vue/vite.config.mjs",
    "dev:demo:plugins": "JS9_INCLUDE_PLUGINS=1 vite --config demo-vue/vite.config.mjs",
    "build:lib:types": "tsc -p tsconfig.lib.json",
    "prebuild:lib": "npm run build:runtime:ts && npm run build:runtime:bundle",
    "prebuild:lib:plugins": "npm run build:runtime:ts && npm run build:runtime:bundle",
    "prebuild:demo": "npm run build:runtime:ts && npm run build:runtime:bundle",
    "prebuild:demo:plugins": "npm run build:runtime:ts && npm run build:runtime:bundle",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build && npm run build:lib:types",
    "build:lib:plugins": "JS9_INCLUDE_PLUGINS=1 vite build && npm run build:lib:types",
    "build:demo": "vite build --config demo-vue/vite.config.mjs",
    "build:demo:plugins": "JS9_INCLUDE_PLUGINS=1 vite build --config demo-vue/vite.config.mjs",
    "preview:demo": "vite preview --config demo-vue/vite.config.mjs",
    "test:vitest": "vitest run --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onekiloparsec/js9.git"
  },
  "keywords": [
    "astronomy",
    "software",
    "image display"
  ],
  "author": "Eric Mandel <eric@cfa.harvard.edu> (https://js9.si.edu)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/onekiloparsec/js9/issues"
  },
  "homepage": "https://js9.si.edu",
  "dependencies": {
    "@onekiloparsec/fixi-js": "^0.5.0"
  },
  "devDependencies": {
    "@onekiloparsec/js9-plugin-simbad": "^0.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@types/node": "^25.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0",
    "vitest": "^4.0.18",
    "vue": "^3.5.21"
  }
}
